# =============================================================================
# ClickHouse — variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e ajuste os valores para seu ambiente.
# NUNCA commite o arquivo .env com valores reais.

# Nome do banco de dados principal do ClickHouse. Consumido por: clickhouse.
CLICKHOUSE_DB=aurix_analytics

# Usuário de acesso ao ClickHouse. Consumido por: clickhouse, clickhouse-client,
# aurix-data-pipelines/sync (postgres_to_clickhouse.py).
CLICKHOUSE_USER=aurix

# Senha do usuário ClickHouse. Consumido por: clickhouse, clickhouse-client,
# aurix-data-pipelines/sync (postgres_to_clickhouse.py).
CLICKHOUSE_PASSWORD=replace_with_secure_password
