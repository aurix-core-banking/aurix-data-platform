# =============================================================================
# Kafka / Confluent Platform — variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e ajuste os valores para seu ambiente.
# NUNCA commite o arquivo .env com valores reais.

# Porta host exposta pela interface web do Kafka UI. Consumido por: kafka-ui.
# Use 8085 (padrão) para evitar conflito com Keycloak (8080) na infra principal.
KAFKA_UI_PORT=8085

# Fator de replicação para tópicos Kafka. Consumido por: kafka, kafka-connect.
# Mantenha 1 em dev (single-broker). Use 3 em staging/produção (multi-broker).
KAFKA_REPLICATION_FACTOR=1

# Porta host do Kafka UI para o perfil staging. Consumido por: kafka-ui.
STAGING_KAFKA_UI_PORT=8085

# Porta host do Schema Registry para o perfil staging. Consumido por: schema-registry.
STAGING_SCHEMA_REGISTRY_PORT=8081

# Porta host do Kafka Connect para o perfil staging. Consumido por: kafka-connect.
STAGING_KAFKA_CONNECT_PORT=8083

# Fator de replicação para tópicos Kafka no perfil staging (3 brokers).
STAGING_KAFKA_REPLICATION_FACTOR=3
