# =============================================================================
# TimescaleDB — variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e ajuste os valores para seu ambiente.
# NUNCA commite o arquivo .env com valores reais.

# Nome do banco de dados TimescaleDB. Consumido por: timescaledb,
# aurix-data-pipelines/airflow/dags/timescaledb_ingestion.py.
TIMESCALEDB_DB=aurix_timeseries

# Usuário do PostgreSQL/TimescaleDB. Consumido por: timescaledb,
# aurix-data-pipelines/airflow/dags/timescaledb_ingestion.py.
TIMESCALEDB_USER=aurix

# Senha do usuário TimescaleDB. Consumido por: timescaledb,
# aurix-data-pipelines/airflow/dags/timescaledb_ingestion.py.
TIMESCALEDB_PASSWORD=replace_with_secure_password

# Host do TimescaleDB para conexões externas (DAGs Airflow, etc.).
TIMESCALEDB_HOST=localhost

# Porta do TimescaleDB (mapeada para 5433 no host para não conflitar com PostgreSQL principal).
TIMESCALEDB_PORT=5433
