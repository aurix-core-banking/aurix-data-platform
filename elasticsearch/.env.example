# =============================================================================
# Elasticsearch / Kibana / Logstash / Filebeat — variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e ajuste os valores para seu ambiente.
# NUNCA commite o arquivo .env com valores reais.

# Senha do usuário elastic (superusuário). Consumido por: elasticsearch.
# Obrigatório quando ELASTICSEARCH_SECURITY_ENABLED=true.
ELASTIC_PASSWORD=replace_with_secure_password

# Habilita autenticação e TLS no Elasticsearch (xpack.security).
# Use false em dev local; use true em staging/produção.
ELASTICSEARCH_SECURITY_ENABLED=false
